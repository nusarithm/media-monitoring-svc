# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@host:5432/medmon

# JWT Configuration
SECRET_KEY=your_secret_key_here_change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Media Monitoring
SMTP_VERIFY_SSL=True

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Application Configuration
APP_NAME=Media Monitoring Service
APP_VERSION=1.0.0
DEBUG=False

# CORS - comma separated list of allowed browser origins
CORS_ORIGINS=https://monitor.nusarithm.id

# Elasticsearch Configuration
ELASTICSEARCH_HOST=https://local-es.nusarithm.id/
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=UtyCantik12
ELASTICSEARCH_INDEX=online-news-*
